    const cols = getComputedStyle(grid).gridTemplateColumns.split(' ').filter(Boolean).length;
    if (cols < 2) return; // panel is hidden; measured again when it is shown
    const items = Array.from(grid.children) as HTMLElement[];
    const n = presetsOpen ? items.length : cols * 2;
    items.forEach((el, i) => { el.hidden = i >= n; });
    btn.hidden = items.length <= cols * 2;
    btn.setAttribute('aria-expanded', String(presetsOpen));
    btn.textContent = presetsOpen ? T('d_fewer') : T('d_all', { n: items.length });
  }
  const presetGrid = document.querySelector('.presets');
  if (presetGrid && 'ResizeObserver' in window) new ResizeObserver(layoutPresets).observe(presetGrid);
  layoutPresets();

  const det = document.querySelector<HTMLDetailsElement>('[data-details]');
  det?.addEventListener('toggle', () => set({ showCode: det.open }));

  // Tabs: click, keyboard, and swipe (left→right = previous, right→left = next).
  (() => {
    const tabs = Array.from(document.querySelectorAll<HTMLElement>('[data-tab]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
    const host = document.querySelector<HTMLElement>('[data-panels]')!;
    let cur = 0;
    const show = (i: number, focus = false) => {
      cur = Math.max(0, Math.min(tabs.length - 1, i));
      tabs.forEach((b, j) => { b.setAttribute('aria-selected', String(j === cur)); b.tabIndex = j === cur ? 0 : -1; });
      panels.forEach((p, j) => { p.hidden = j !== cur; });
      tabs[cur].scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
      if (focus) tabs[cur].focus();
    };
    tabs.forEach((b, j) => {
      b.addEventListener('click', () => show(j));
      b.addEventListener('keydown', e => {
        if (e.key === 'ArrowRight') { e.preventDefault(); show(cur + 1, true); }
        else if (e.key === 'ArrowLeft') { e.preventDefault(); show(cur - 1, true); }
      });
    });
    let x0 = 0, y0 = 0, tracking = false;
    const skip = (el: EventTarget | null) => el instanceof HTMLElement && !!el.closest('input[type="range"], input[type="text"], textarea');
    host.addEventListener('touchstart', e => { tracking = !skip(e.target); x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
    host.addEventListener('touchend', e => {
      if (!tracking) return; tracking = false;
      const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
      if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy) * 1.5) show(cur + (dx < 0 ? 1 : -1) * (document.documentElement.dir === 'rtl' ? -1 : 1));
    }, { passive: true });
    show(0);
  })();

  // Help boxes: always open on wide screens, collapsible dropdowns on mobile.
  (() => {
    const mq = window.matchMedia('(min-width: 720px)');
    const sync = () => document.querySelectorAll<HTMLDetailsElement>('[data-explain]').forEach(d => { d.open = mq.matches; });
    sync(); mq.addEventListener('change', sync);
  })();
</script>
