  <label class="range"><span>{I.t('crop_zoom')}</span><input type="range" min="100" max="400" step="1" value="100" data-crop-zoom /></label>
  <div class="crop-btns"><button type="button" class="btn ghost" data-crop-act="cancel">{I.t('crop_cancel')}</button><button type="button" class="btn ghost" data-crop-act="skip">{I.t('crop_skip')}</button><button type="button" class="btn primary" data-crop-act="ok">{I.t('crop_ok')}</button></div>
</dialog>

<script id="i18n-data" type="application/json" set:html={JSON.stringify({ ui: I.ui, sheet: I.sheet, names: c.names, defs: c.defs, locale, dir: I.dir, site: Astro.site?.origin })}></script>

<script>
  import { QrCode, QrSegment } from '../lib/qrcodegen.js';
  import { TYPES, BODY, FRAME, BALL, PRESETS, DESIGN_DEFAULTS, FIELD_DEFAULTS, buildSvg, buildPayload, buildSheet, contrast, COLOR_FAMILIES, APP_LINKS, iconLogo, isIconLogo, ICON_STYLES, LOGO_SHAPES } from '../lib/render.js';
  let shownIconStyle = 'plain|48||';
  const mkIcon = (hex: string, path: string) => iconLogo(hex, path, s.iconStyle, s.iconCustom ? s.iconColor : '', s.iconFgCustom ? s.iconFg : '', s.logoRound);

  const I18N = JSON.parse(document.getElementById('i18n-data')!.textContent || '{}');
  const T = (id: string, v?: Record<string, any>) => { const s0: string = (I18N.ui && I18N.ui[id]) ?? id; return v ? s0.replace(/\{(\w+)\}/g, (_: string, k: string) => String(v[k] ?? '')) : s0; };
  const TS = (eng: string, v?: Record<string, any>) => { const s0: string = (I18N.sheet && I18N.sheet[eng]) ?? eng; return v ? s0.replace(/\{(\w+)\}/g, (_: string, k: string) => String(v[k] ?? '')) : s0; };
  const STORE = 'qrcodestation-state-v1';
  const root = document.getElementById('qr-app')!;
  const $ = (sel: string) => root.querySelector(sel) as any;
  const $$ = (sel: string) => Array.from(root.querySelectorAll(sel)) as any[];

  const defaults = () => ({ type: 'url', data: { ...FIELD_DEFAULTS, ...(I18N.defs || {}) }, ...DESIGN_DEFAULTS, qfText: T('qf_text'), logo: null as string | null, logos: [] as string[], logoBg: false, logoBgColor: '#FFFFFF', logoStroke: false, logoStrokeColor: '#FFFFFF', logoStrokeW: 3, logoPct: 22, clearLogo: true, iconStyle: 'plain', logoRound: 48, iconCustom: false, iconColor: '#0B0D0C', iconFgCustom: false, iconFg: '#FFFFFF', ecc: 'M', boost: true, mask: -1, border: 4, radius: 0, presetMode: 'all', minVer: 1, maxVer: 40, exportSize: 1024, showCode: false, defHidden: false, stash: {} as Record<string, string> });
  let s: any = defaults();
  try {
    const saved = JSON.parse(localStorage.getItem(STORE) || 'null');
    if (saved) {
      // Saved example text that was never edited should follow the page language instead of sticking to another one.
      const sd = Object.fromEntries(Object.entries(saved.data || {}).filter(([k, v]) => v !== FIELD_DEFAULTS[k as keyof typeof FIELD_DEFAULTS] || !(I18N.defs && k in I18N.defs)));
      s = { ...s, ...saved, data: { ...s.data, ...sd }, showCode: false };
    }
  } catch (e) {}
  // Landing pages (e.g. /wifi-qr-code/) always open on their own content type.
  if (!Array.isArray(s.logos)) s.logos = [];
  s.exportSize = 2 ** Math.min(12, Math.max(4, Math.round(Math.log2(+s.exportSize || 1024))));   // sizes are powers of two
  // Older saved styles: square / rounded / circle became one 'round' shape with a roundness value.
  if (s.iconStyle === 'brand' || s.iconStyle === 'mono') s.iconStyle = 'plain';
  else if (s.iconStyle === 'square') { s.iconStyle = 'round'; s.logoRound = 0; }
  else if (s.iconStyle === 'rounded') { s.iconStyle = 'round'; s.logoRound = 48; }
  else if (s.iconStyle === 'circle') { s.iconStyle = 'round'; s.logoRound = 100; }
  else if (!ICON_STYLES.includes(s.iconStyle)) s.iconStyle = 'round';
  if (s.logo && !s.logos.includes(s.logo) && !isIconLogo(s.logo)) s.logos = [...s.logos, s.logo];
  if (root.dataset.initialType) s.type = root.dataset.initialType;

  let last: any = null, saveT: any;
  const set = (patch: any) => { s = { ...s, ...patch }; render(); };
  const setField = (k: string, v: any) => { s = { ...s, data: { ...s.data, [k]: v } }; render(); };

  const SHOW: Record<string, () => boolean> = {
    gradient: () => s.gradient, linear: () => s.gradient && s.gradType === 'linear', bg: () => !s.transparent,
    eyes: () => s.customEyes, logo: () => !!s.logo, logoMany: () => s.logos.length > 0, logoBg: () => s.logoBg, logoStyle: () => s.logoBg || s.logoStroke, logoStroke: () => s.logoStroke, logoWarn: () => !!s.logo && (s.ecc === 'L' || s.ecc === 'M'),
    qfOn: () => s.qf !== 'none', iconCustom: () => s.iconCustom, iconFgCustom: () => s.iconFgCustom, iconAny: () => s.iconCustom || s.iconFgCustom, iconRound: () => s.iconStyle === 'round',
    qfTextColor: () => s.qf !== 'none' && s.qfCustomText,
    anyWarn: () => SHOW.lowContrast() || SHOW.logoWarn(),
    lowContrast: () => contrast(s.fg, s.transparent ? '#FFFFFF' : s.bg) < 3,
  };

  function encode(text: string) {
    if (!text) return { msg: T('v_fill') };
    try {
      const E = QrCode.Ecc, ecl = ({ L: E.LOW, M: E.MEDIUM, Q: E.QUARTILE, H: E.HIGH } as any)[s.ecc];
      const segs = QrSegment.makeSegments(text);
      const qr = QrCode.encodeSegments(segs, ecl, Math.min(s.minVer, s.maxVer), Math.max(s.minVer, s.maxVer), s.mask, s.boost);
      return { qr, segs, bits: QrSegment.getTotalBits(segs, qr.version), cap: QrCode.getNumDataCodewords(qr.version, qr.errorCorrectionLevel) * 8 };
    } catch (e) {
      return { msg: T('v_toomuch') };
    }
  }
  const svgOpts = () => ({ ...s, logoSize: s.logoPct / 100 });

  const thumbQr = QrCode.encodeText('https://example.com', QrCode.Ecc.LOW);
  let thumbKey = 'all';
  const pick = (o: any, ks: string[]) => Object.fromEntries(ks.map(k => [k, o[k]]));
  let lastPreset = -1;
  function applyPreset(i: number) {
    const { qf, qfText, qfColor, qfBg, qfCustomText, qfTextColor, ...p } = PRESETS[i] as any; lastPreset = i;
    set(s.presetMode === 'shape' ? { body: p.body, frame: p.frame, ball: p.ball } : { ...p });
  }
  const pal: Record<string, { fam: string; target: string }> = {};
  const palOK = (k: string) => ({ grad2: s.gradient, bg: !s.transparent, frameColor: s.customEyes, ballColor: s.customEyes, qfColor: s.qf !== 'none', qfBg: s.qf !== 'none', qfTextColor: s.qf !== 'none' && s.qfCustomText, iconColor: s.iconCustom, iconFg: s.iconFgCustom, logoBgColor: s.logoBg, logoStrokeColor: s.logoStroke } as Record<string, boolean>)[k] ?? true;
  function syncPalette() {
    $$('[data-palette]').forEach(root => {
      const sc = root.dataset.palette!, st = pal[sc] ||= { fam: '', target: root.dataset.default! };
      const fam = COLOR_FAMILIES.find(f => f.id === st.fam);
      if (!palOK(st.target)) st.target = Array.from(root.querySelectorAll<HTMLElement>('[data-apply]')).map(b => b.dataset.apply!).find(palOK) || root.dataset.default!;
      (root.querySelector('[data-shades-wrap]') as HTMLElement).hidden = !fam;
      root.querySelectorAll<HTMLElement>('[data-family]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.family === st.fam)));
      root.querySelectorAll<HTMLElement>('[data-apply]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.apply === st.target)));
      const box = root.querySelector('[data-shades]') as HTMLElement;
      if (fam && box.dataset.fam !== fam.id) {
        box.dataset.fam = fam.id;
        box.replaceChildren(...fam.shades.map(c => {
          const b = document.createElement('button'); b.type = 'button'; b.className = 'shade'; b.dataset.shade = c; b.setAttribute('aria-label', c);
          b.style.background = c; return b;
        }));
      }
      box.querySelectorAll<HTMLElement>('[data-shade]').forEach(b => b.setAttribute('aria-pressed', String(String(s[st.target]).toLowerCase() === b.dataset.shade!.toLowerCase())));
    });
  }

  // What is saved in the browser: only values that differ from the defaults, and logos under ~400 KB.
  function snapshot() {
    const dd = defaults().data as Record<string, any>; const out: any = { ...s, showCode: false, data: Object.fromEntries(Object.entries(s.data).filter(([k, v]) => v !== dd[k])) };
    out.logos = s.logos.filter((l: string) => l.length <= 400000); if (out.logo && out.logo.length > 400000) out.logo = null;
    return out;
  }
  const FAVS = 'qrcodestation-favs-v1';
  const loadFavs = (): any[] => { try { const v = JSON.parse(localStorage.getItem(FAVS) || '[]'); return Array.isArray(v) ? v : []; } catch (e) { return []; } };
  const hashOf = (t: string) => { let h = 5381; for (let i = 0; i < t.length; i++) h = (h * 33 + t.charCodeAt(i)) | 0; return (h >>> 0).toString(36) + t.length.toString(36); };
  let favId = '';

  function render() {
    const active = document.activeElement;
    $$('[data-type]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.type === s.type)));
    $$('[data-fields]').forEach(el => { el.hidden = el.dataset.fields !== s.type; });
    $$('[data-showif]').forEach(el => { const [k, v] = el.dataset.showif.split('='); el.hidden = String(s.data[k]) !== v; });
    $$('[data-help]').forEach(el => { el.hidden = el.dataset.help !== s.type; });
    $$('[data-field]').forEach(el => {
      const v = s.data[el.dataset.field] ?? ''; if (el !== active && el.value !== v) el.value = v;
      if (el.tagName === 'SELECT') return;
      // While example values are hidden, they show as the placeholder (grey) instead.
      if (el.dataset.ph0 === undefined) el.dataset.ph0 = el.placeholder;
      el.placeholder = (s.defHidden && s.stash && s.stash[el.dataset.field]) || el.dataset.ph0;
    });
    $$('[data-social]').forEach(b => b.setAttribute('aria-pressed', String(!!s.data.url && s.data.url.startsWith(b.dataset.prefix))));
    $$('[data-field-opt]').forEach(b => b.setAttribute('aria-pressed', String(s.data[b.dataset.fieldOpt] === b.dataset.value)));
    $$('[data-field-bool]').forEach(el => { el.checked = !!s.data[el.dataset.fieldBool]; });
    $$('[data-opt]').forEach(b => b.setAttribute('aria-pressed', String(String(s[b.dataset.opt]) === b.dataset.value)));
    $$('[data-bool]').forEach(el => { el.checked = !!s[el.dataset.bool]; });
    $$('[data-str]').forEach(el => { if (el !== active && el.value !== s[el.dataset.str]) el.value = s[el.dataset.str] ?? ''; });
    $$('[data-num]').forEach(el => { if (el !== active) el.value = s[el.dataset.num]; });
    $$('[data-pow]').forEach(el => { if (el !== active) el.value = String(Math.log2(s[el.dataset.pow])); });
    $$('[data-out]').forEach(el => { const k = el.dataset.out; el.textContent = k === 'exportSize' ? `${s[k]} × ${s[k]}` : s[k] + (el.dataset.suffix || ''); });
    $$('[data-color]').forEach(el => { if (/^#[0-9a-f]{6}$/i.test(s[el.dataset.color])) el.value = s[el.dataset.color].toLowerCase(); });
    $$('[data-hex]').forEach(el => { if (el !== active) el.value = s[el.dataset.hex]; });
    $$('[data-show]').forEach(el => { el.hidden = !SHOW[el.dataset.show](); });
    syncPalette();
    const tk = s.presetMode === 'shape' ? ['fg', 'grad2', 'gradient', 'gradType', 'gradAngle', 'bg', 'transparent', 'customEyes', 'frameColor', 'ballColor'].map(k => s[k]).join('|') : 'all';
    if (thumbKey !== tk) {
      thumbKey = tk;
      $$('[data-preset]').forEach(b => {
        const p = PRESETS[+b.dataset.preset!];
        const o = s.presetMode === 'shape' ? { ...DESIGN_DEFAULTS, ...pick(s, ['fg', 'grad2', 'gradient', 'gradType', 'gradAngle', 'bg', 'transparent', 'customEyes', 'frameColor', 'ballColor']), body: p.body, frame: p.frame, ball: p.ball } : p;
        (b.querySelector('.preset-thumb') as HTMLElement).innerHTML = buildSvg(thumbQr, { ...o, border: 2 });
      });
    }
    $('[data-fg-label]').textContent = s.gradient ? T('c_gstart') : T('c_code');
    const iconKey = [s.iconStyle, s.logoRound, s.iconCustom ? s.iconColor : '', s.iconFgCustom ? s.iconFg : ''].join('|');
    if (iconKey !== shownIconStyle) {
      // Redraw the icon buttons in the chosen style and color; if the code shows one of them, switch it too.
      shownIconStyle = iconKey; let swap: string | null = null;
      $$('[data-sample-logo][data-ihex]').forEach(b => {
        const url = mkIcon(b.dataset.ihex, b.dataset.ipath);
        if (b.dataset.sampleLogo === s.logo) swap = url;
        b.dataset.sampleLogo = url; b.querySelector('img').src = url;
      });
      if (swap) { set({ logo: swap }); return; }
    }
    $$('[data-sample-logo]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.sampleLogo === s.logo)));
    $('[data-action="noLogo"]').setAttribute('aria-pressed', String(!s.logo));
    const lkey = s.logos.length + '|' + s.logos.indexOf(s.logo);
    const list = $('[data-logo-list]');
    if (list.dataset.key !== lkey) {
      list.dataset.key = lkey;
      list.replaceChildren(...s.logos.map((src: string, i: number) => {
