    const a = (e.target as HTMLElement).closest('[data-crop-act]') as HTMLElement | null; if (!a) return;
    if (a.dataset.cropAct === 'ok') {
      const out = document.createElement('canvas'); out.width = out.height = 512; crDraw(out);
      crEnd(out.toDataURL('image/webp', .92));
    } else {
      if (a.dataset.cropAct !== 'skip' || !cr.img) { crEnd(null); return; }
      // Keep original: the whole image, centered in a square with a margin, so portrait pictures fit every shape.
      const out = document.createElement('canvas'); out.width = out.height = 512; const g2 = out.getContext('2d')!;
      const k = Math.min(448 / cr.img.naturalWidth, 448 / cr.img.naturalHeight), w = cr.img.naturalWidth * k, h = cr.img.naturalHeight * k;
      g2.drawImage(cr.img, (512 - w) / 2, (512 - h) / 2, w, h); crEnd(out.toDataURL('image/webp', .92));
    }
  });
  dlg.addEventListener('cancel', (e) => { e.preventDefault(); crEnd(null); });
  async function addLogoFiles(all: File[]) {
    const files = all.filter(f => f.type.startsWith('image/')); if (!files.length) return;
    const urls = await Promise.all(files.map(f => new Promise<string>(res => { const rd = new FileReader(); rd.onload = () => res(rd.result as string); rd.readAsDataURL(f); })));
    const out: string[] = [];
    for (const u of urls) { const c = u.startsWith('data:image/svg+xml') ? u : await cropLogo(u); if (c) out.push(c); }   // SVG stays vector
    if (!out.length) return;
    set({ logos: [...s.logos, ...out.filter(u => !s.logos.includes(u))], logo: out[out.length - 1] });
  }
  // Drag and drop images onto the upload button / logo row.
  const dz = (e: DragEvent) => ((e.target as HTMLElement).closest('[data-dropzone]') as HTMLElement | null);
  const hasFiles = (e: DragEvent) => !!e.dataTransfer && Array.from(e.dataTransfer.types).includes('Files');
  ['dragenter', 'dragover'].forEach(ev => root.addEventListener(ev, (e: any) => { const z = dz(e); if (z && hasFiles(e)) { e.preventDefault(); e.dataTransfer.dropEffect = 'copy'; z.classList.add('dragover'); } }));
  root.addEventListener('dragleave', (e: any) => { const z = dz(e); if (z && !z.contains(e.relatedTarget as Node)) z.classList.remove('dragover'); });
  root.addEventListener('drop', (e: any) => { const z = dz(e); if (!z) return; e.preventDefault(); z.classList.remove('dragover'); addLogoFiles(Array.from(e.dataTransfer?.files || []) as File[]); });
  root.addEventListener('change', (e) => {
    const t = e.target as any, d = t.dataset;
    if (d.bool) set({ [d.bool]: t.checked });
    else if (d.fieldBool) setField(d.fieldBool, t.checked);
    else if (t.hasAttribute('data-logo-file')) { addLogoFiles(Array.from(t.files || []) as File[]); t.value = ''; }
  });

  render();

  // Small screens: one floating button jumps between the settings and the QR code.
  const fab = $('[data-action="toggleView"]'), sideEl = root.querySelector('.gen-side') as HTMLElement;
  let fabT = 0; const stackMq = window.matchMedia('(max-width: 971px)');
  function syncFab() {
    fabT = 0; const r = sideEl.getBoundingClientRect(), vh = window.innerHeight;
    const qr = stackMq.matches && r.top < vh * .45 && r.bottom > vh * .25;
    fab.dataset.view = qr ? 'qr' : 'settings';
    const l = T(qr ? 'view_settings' : 'view_qr'); fab.setAttribute('aria-label', l); fab.title = l;
  }
  const queueFab = () => { if (!fabT) fabT = requestAnimationFrame(syncFab); };
  window.addEventListener('scroll', queueFab, { passive: true }); window.addEventListener('resize', queueFab); syncFab();
  actions.toggleView = () => {
    if (fab.dataset.view === 'qr') {
      if (root.hasAttribute('data-collapsed')) actions.togglePanel(fab);
      (root.querySelector('.type-bar') as HTMLElement).scrollIntoView({ block: 'start', behavior: 'smooth' });
    } else sideEl.scrollIntoView({ block: 'start', behavior: 'smooth' });
  };

  // Presets: when collapsed show exactly two full rows, whatever the number of columns at this width.
  let presetsOpen = false;
  function layoutPresets() {
    const grid = document.querySelector<HTMLElement>('.presets'), btn = document.querySelector<HTMLElement>('[data-action="togglePresets"]');
    if (!grid || !btn) return;
    const cols = getComputedStyle(grid).gridTemplateColumns.split(' ').filter(Boolean).length;
    if (cols < 2) return; // panel is hidden; measured again when it is shown
    const items = Array.from(grid.children) as HTMLElement[];
    const n = presetsOpen ? items.length : cols * 2;
    items.forEach((el, i) => { el.hidden = i >= n; });
    btn.hidden = items.length <= cols * 2;
    btn.setAttribute('aria-expanded', String(presetsOpen));
    btn.textContent = presetsOpen ? T('d_fewer') : T('d_all', { n: items.length });
  }
  // Arrow keys move through the presets (and apply each one) once a preset has focus.
  document.querySelector('.presets')?.addEventListener('keydown', (e: any) => {
    const grid = e.currentTarget as HTMLElement, cur = (e.target as HTMLElement).closest('.preset') as HTMLElement | null;
    if (!cur || !['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Home', 'End'].includes(e.key)) return;
    const items = (Array.from(grid.children) as HTMLElement[]).filter(el => !el.hidden);
    const cols = Math.max(1, getComputedStyle(grid).gridTemplateColumns.split(' ').filter(Boolean).length);
    const rtl = document.documentElement.dir === 'rtl', i = items.indexOf(cur);
    let n = i;
    if (e.key === 'ArrowRight') n = i + (rtl ? -1 : 1);
    else if (e.key === 'ArrowLeft') n = i + (rtl ? 1 : -1);
    else if (e.key === 'ArrowDown') n = i + cols;
    else if (e.key === 'ArrowUp') n = i - cols;
    else if (e.key === 'Home') n = 0;
    else n = items.length - 1;
    e.preventDefault();
    if (n < 0 || n >= items.length || n === i) return;
    items[n].focus();
    applyPreset(+items[n].dataset.preset!);
  });
  // Same arrow-key browsing for the body shape, eye frame and eye ball tiles.
  document.querySelectorAll<HTMLElement>('.tiles').forEach(grid => grid.addEventListener('keydown', (e: any) => {
    const cur = (e.target as HTMLElement).closest('.tile') as HTMLElement | null;
    if (!cur || !['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Home', 'End'].includes(e.key)) return;
    const items = Array.from(grid.querySelectorAll<HTMLElement>('.tile'));
    const cols = Math.max(1, getComputedStyle(grid).gridTemplateColumns.split(' ').filter(Boolean).length);
    const rtl = document.documentElement.dir === 'rtl', i = items.indexOf(cur);
    let n = i;
    if (e.key === 'ArrowRight') n = i + (rtl ? -1 : 1);
    else if (e.key === 'ArrowLeft') n = i + (rtl ? 1 : -1);
    else if (e.key === 'ArrowDown') n = i + cols;
    else if (e.key === 'ArrowUp') n = i - cols;
    else if (e.key === 'Home') n = 0;
    else n = items.length - 1;
    e.preventDefault();
    if (n < 0 || n >= items.length || n === i) return;
    items[n].focus();
    items[n].click();
  }));
  const presetGrid = document.querySelector('.presets');
  if (presetGrid && 'ResizeObserver' in window) new ResizeObserver(layoutPresets).observe(presetGrid);
  layoutPresets();

  const det = document.querySelector<HTMLDetailsElement>('[data-details]');
  det?.addEventListener('toggle', () => set({ showCode: det.open }));

  // Tabs: click, keyboard, and swipe (left→right = previous, right→left = next).
  (() => {
    const tabs = Array.from(document.querySelectorAll<HTMLElement>('[data-tab]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
    let cur = 0;
    // The underline under the tabs is its own element so it can follow the finger while swiping.
    const ind = document.querySelector<HTMLElement>('.tab-ind')!;
    const placeInd = (to = -1, p = 0, anim = true) => {
      const a = tabs[cur], b = to >= 0 && tabs[to] ? tabs[to] : a;
      ind.style.transition = anim ? '' : 'none';
      ind.style.width = (a.offsetWidth + (b.offsetWidth - a.offsetWidth) * p) + 'px';
      ind.style.transform = `translateX(${a.offsetLeft + (b.offsetLeft - a.offsetLeft) * p}px)`;
    };
    window.addEventListener('resize', () => placeInd(-1, 0, false));
    document.fonts?.ready.then(() => placeInd(-1, 0, false));
    const show = (i: number, focus = false) => {
      cur = Math.max(0, Math.min(tabs.length - 1, i));
      tabs.forEach((b, j) => { b.setAttribute('aria-selected', String(j === cur)); b.tabIndex = j === cur ? 0 : -1; });
      panels.forEach((p, j) => { p.hidden = j !== cur; });
      tabs[cur].scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
      placeInd();
      if (focus) tabs[cur].focus();
    };
    tabs.forEach((b, j) => {
      b.addEventListener('click', () => show(j));
      b.addEventListener('keydown', e => {
        if (e.key === 'ArrowRight') { e.preventDefault(); show(cur + 1, true); }
        else if (e.key === 'ArrowLeft') { e.preventDefault(); show(cur - 1, true); }
      });
    });
    // Swipe: the panel follows the finger; letting go past a third of the width (or with a quick flick) switches tab.
    let x0 = 0, y0 = 0, t0 = 0, tracking = false, lock = '', W = 360;
    const rtl = () => document.documentElement.dir === 'rtl';
    const kids = () => Array.from(panels[cur].children) as HTMLElement[];
    const move = (dx: number, ease: string, op = 1) => kids().forEach(k => { k.style.transition = ease; k.style.transform = dx ? `translateX(${dx}px)` : ''; k.style.opacity = op === 1 ? '' : String(op); });
    const dirOf = (dx: number) => (dx < 0 ? 1 : -1) * (rtl() ? -1 : 1);
    const skip = (el: EventTarget | null) => el instanceof HTMLElement && !!el.closest('input[type="range"], .type-bar, .tabs, .view-fab');
    root.addEventListener('touchstart', e => {
      tracking = !skip(e.target) && e.touches.length === 1; lock = '';
      x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; t0 = e.timeStamp;
      W = Math.max(200, Math.min(root.getBoundingClientRect().width || 360, window.innerWidth));
    }, { passive: true });
    root.addEventListener('touchmove', e => {
      if (!tracking) return;
      const dx = e.touches[0].clientX - x0, dy = e.touches[0].clientY - y0;
      if (!lock) { if (Math.abs(dx) > 10 && Math.abs(dx) > Math.abs(dy)) lock = 'h'; else if (Math.abs(dy) > 10) { lock = 'v'; tracking = false; } }
      if (lock !== 'h') return;
      const n = cur + dirOf(dx), edge = n < 0 || n > tabs.length - 1;
      const d = edge ? dx * .25 : dx;
      move(d, 'none', 1 - Math.min(.6, Math.abs(d) / W));
      placeInd(edge ? -1 : n, Math.min(1, Math.abs(d) / W), false);
    }, { passive: true });
    const finish = (e: TouchEvent, cancelled: boolean) => {
      if (!tracking) return; tracking = false;
      if (lock !== 'h') return;
      const dx = (cancelled ? 0 : e.changedTouches[0].clientX - x0), v = Math.abs(dx) / Math.max(1, e.timeStamp - t0);
      const dir = dirOf(dx), n = cur + dir;
      if (cancelled || n < 0 || n > tabs.length - 1 || !(Math.abs(dx) > W * .3 || (v > .5 && Math.abs(dx) > 40))) { move(0, 'transform .2s ease, opacity .2s ease'); placeInd(); return; }
      const out = dx < 0 ? -W : W;
      move(out, 'transform .16s ease-in, opacity .16s ease-in', 0);
      setTimeout(() => {
        move(0, 'none'); show(n);
        kids().forEach(k => { k.style.transition = 'none'; k.style.transform = `translateX(${-out * .25}px)`; k.style.opacity = '0'; });
        requestAnimationFrame(() => requestAnimationFrame(() => move(0, 'transform .2s ease-out, opacity .2s ease-out')));
        setTimeout(() => kids().forEach(k => { k.style.transition = ''; }), 260);
      }, 160);
    };
    root.addEventListener('touchend', e => finish(e, false), { passive: true });
    root.addEventListener('touchcancel', e => finish(e, true), { passive: true });
    show(0);
  })();

  // Small screens: long tile lists show one row; a round button expands them.
  (() => {
    const chevron = '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>';
    document.querySelectorAll<HTMLElement>('.tiles').forEach(list => {
      const grp = list.parentElement as HTMLElement; grp.classList.add('has-expand'); list.dataset.fold = '';
      const btn = document.createElement('button'); btn.type = 'button'; btn.className = 'expand-btn'; btn.innerHTML = chevron;
      const sync = () => { const o = list.hasAttribute('data-open'); btn.setAttribute('aria-expanded', String(o)); btn.setAttribute('aria-label', T(o ? 'collapse' : 'expand')); btn.title = T(o ? 'collapse' : 'expand'); };
      btn.addEventListener('click', () => { list.toggleAttribute('data-open'); sync(); });
      grp.appendChild(btn); sync();
      let lastW = 0;
      new ResizeObserver(() => {
        const w = list.clientWidth; if (!w || w === lastW) return; lastW = w;
        const t = list.querySelector<HTMLElement>('.tile'); if (t) list.style.setProperty('--row1', t.getBoundingClientRect().height + 'px');
      }).observe(list);
    });
  })();

  // Help boxes: always open on wide screens, collapsible dropdowns on mobile.
  (() => {
    const mq = window.matchMedia('(min-width: 720px)');
    const sync = () => document.querySelectorAll<HTMLDetailsElement>('[data-explain]').forEach(d => { d.open = mq.matches; });
    sync(); mq.addEventListener('change', sync);
  })();
</script>
