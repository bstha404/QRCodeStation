---
import { QrCode } from '../lib/qrcodegen.js';
import { siFacebook, siYoutube, siX, siInstagram, siTelegram, siSignal, siMastodon, siTiktok, siThreads, siBluesky, siPinterest, siSnapchat, siReddit, siGithub, siDiscord, siTwitch, siWhatsapp, siSpotify, siGmail, siGooglemaps, siPaypal } from 'simple-icons';
import ColorPresets from './ColorPresets.astro';
import HelpBox from './HelpBox.astro';
import { useI18n } from '../i18n/index.js';
import { SOCIALS, TYPES, BODY, FRAME, BALL, ECC, PRESETS, DESIGN_DEFAULTS, FIELD_DEFAULTS, buildSvg, bodyThumb, frameThumb, ballThumb, QFRAMES, qrFrameThumb, iconLogo, isIconLogo, ICON_STYLES, LOGO_SHAPES } from '../lib/render.js';

const ICONS: Record<string, string> = Object.fromEntries(Object.entries({
  facebook: siFacebook, youtube: siYoutube, x: siX, instagram: siInstagram, telegram: siTelegram, signal: siSignal, mastodon: siMastodon,
  tiktok: siTiktok, threads: siThreads, bluesky: siBluesky, pinterest: siPinterest, snapchat: siSnapchat, reddit: siReddit,
  github: siGithub, discord: siDiscord, twitch: siTwitch, whatsapp: siWhatsapp,
}).map(([k, v]) => [k, v.path]));
// simple-icons dropped the LinkedIn logo, so it is drawn from its own path (24×24 viewBox).
ICONS.linkedin = 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';
// Sample logos people can try before uploading their own: the brand glyph in white on its brand color.
const SAMPLE_LOGOS = [siInstagram, siFacebook, siYoutube, siWhatsapp, siX, siTiktok, { title: 'LinkedIn', hex: '0A66C2', path: ICONS.linkedin }, siTelegram, siSpotify, siGmail, siGooglemaps, siPaypal].map(i => ({ title: i.title, hex: i.hex, path: i.path, url: iconLogo(i.hex, i.path) }));
const { initialType = 'url', locale = 'en' } = Astro.props;
const I = useI18n(locale);
const x = I.x;
const N = I.N;
const c = I.c;
const FD = { ...FIELD_DEFAULTS, ...c.defs };
const isUrl = initialType === 'url';
// Rendered at build time so the page ships a real QR code and thumbnails in the HTML.
const sample = QrCode.encodeText('https://example.com', QrCode.Ecc.LOW);
const initialQr = QrCode.encodeText(FIELD_DEFAULTS.url, QrCode.Ecc.MEDIUM);
const initialSvg = isUrl ? buildSvg(initialQr, { ...DESIGN_DEFAULTS, border: 4 }) : '';
const presetSvgs = PRESETS.map(p => buildSvg(sample, { ...p, border: 2 }));
---
<div class="gen" id="qr-app" data-locale={locale} data-initial-type={isUrl ? undefined : initialType}>
  <div class="type-bar pills" role="group" aria-label="Content type">
    {TYPES.map(t => <button type="button" class="pill" data-type={t.id} aria-pressed={t.id === initialType ? 'true' : 'false'}>{x(t.label)}</button>)}
  </div>
  <button type="button" class="view-fab" data-action="toggleView" data-view="settings" aria-label={I.t('view_qr')} title={I.t('view_qr')}>
    <svg class="fab-qr" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="3.500" y="3.500" width="7" height="7" rx="1"/><rect x="13.500" y="3.500" width="7" height="7" rx="1"/><rect x="3.500" y="13.500" width="7" height="7" rx="1"/><path d="M14 14h2.500v2.500H14zM18 18h2.500v2.500H18zM18 14h2.500M14 18h2.500" stroke-linecap="round"/></svg>
    <svg class="fab-set" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h9M17 7h3M4 17h3M11 17h9"/><circle cx="15" cy="7" r="2"/><circle cx="9" cy="17" r="2"/></svg>
  </button>
  <div class="tabs" role="tablist" aria-label="QR code options">
    <span class="tab-ind" aria-hidden="true"></span>
    <button type="button" class="tab" role="tab" id="tab-content" aria-controls="panel-content" data-tab="content" aria-selected="true"><span class="step">1</span><span class="tab-name">{x("Content")}</span></button>
    <button type="button" class="tab" role="tab" id="tab-design" aria-controls="panel-design" data-tab="design" aria-selected="false"><span class="step">2</span><span class="tab-name">{x("Design")}</span><span class="card-sum" data-summary="design"></span></button>
    <button type="button" class="tab" role="tab" id="tab-logo" aria-controls="panel-logo" data-tab="logo" aria-selected="false"><span class="step">3</span><span class="tab-name">{x("Logo")}</span><span class="card-sum" data-summary="logo">{x("None")}</span></button>
    <button type="button" class="tab" role="tab" id="tab-colors" aria-controls="panel-colors" data-tab="colors" aria-selected="false"><span class="step">4</span><span class="tab-name">{x("Colors")}</span><span class="card-sum" data-summary="colors">{x("Solid")}</span></button>
    <button type="button" class="tab" role="tab" id="tab-encoding" aria-controls="panel-encoding" data-tab="encoding" aria-selected="false"><span class="step">5</span><span class="tab-name">{x("Encoding")}</span><span class="card-sum" data-summary="encoding">ECC M · v1–40</span></button>
  </div>
  <div class="gen-body">
  <div class="gen-main" data-panels>
    <div class="panel panel-stack" role="tabpanel" id="panel-content" aria-labelledby="tab-content" data-panel="content">
    <section class="card">
      <div class="card-bar"><span>{x("Settings")}</span><span class="bar-actions"><button type="button" class="icon-btn" data-action="toggleDefaults" aria-pressed="false" aria-label={I.t('hide_defaults')} title={I.t('hide_defaults')}>
          <svg class="eye-on" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.500-7 10-7 10 7 10 7-3.500 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
          <svg class="eye-off" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3l18 18M10.600 6.100A10 10 0 0 1 12 5c6.500 0 10 7 10 7a17 17 0 0 1-3.200 4.200M6.600 6.600A17 17 0 0 0 2 12s3.500 7 10 7c1.700 0 3.200-.4 4.500-1.100M9.900 9.900a3 3 0 0 0 4.200 4.200"/></svg>
        </button><button type="button" class="collapse-btn" data-action="togglePanel" aria-expanded="true" aria-label={x("Collapse settings")}>−</button></span></div>
      <div class="card-body" style="padding-top:20px">
        <div class="eye-row"><button type="button" class="icon-btn" data-action="toggleDefaults" aria-pressed="false" aria-label={I.t('hide_defaults')} title={I.t('hide_defaults')}>
          <svg class="eye-on" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.500-7 10-7 10 7 10 7-3.500 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
          <svg class="eye-off" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3l18 18M10.600 6.100A10 10 0 0 1 12 5c6.500 0 10 7 10 7a17 17 0 0 1-3.200 4.200M6.600 6.600A17 17 0 0 0 2 12s3.500 7 10 7c1.700 0 3.200-.4 4.500-1.100M9.900 9.900a3 3 0 0 0 4.200 4.200"/></svg>
        </button></div>
        {TYPES.map(t => (
          <div class="fields" data-fields={t.id} hidden={t.id !== initialType}>
            {t.fields.map(f => (
              <div class:list={['field', f.half && 'half']} data-showif={f.showIf ? f.showIf.join('=') : undefined} hidden={f.showIf ? FD[f.showIf[0]] !== f.showIf[1] : undefined}>
                {f.type === 'select' ? (
                  <>
                    <span class="label">{x(f.label)}</span>
                    <div class="pills" role="group" aria-label={x(f.label)}>
                      {f.options.map(([v, l]) => <button type="button" class="pill" data-field-opt={f.k} data-value={v} aria-pressed={FD[f.k] === v ? 'true' : 'false'}>{x(l)}</button>)}
                    </div>
                  </>
                ) : (
                  <>
                    <label class="label" for={`f-${f.k}`}>{x(f.label)}</label>
                    {f.type === 'area'
                      ? <textarea class="input" id={`f-${f.k}`} rows="4" data-field={f.k} placeholder={x(f.ph)}>{FD[f.k]}</textarea>
                      : <input class="input" id={`f-${f.k}`} type={f.it || 'text'} data-field={f.k} placeholder={f.ph} value={FD[f.k]} />}
                  </>
                )}
              </div>
            ))}
            {t.id === 'url' && (
              <div class="field social" style="flex:1 1 100%">
                <span class="label">{x("Social media shortcuts")}</span>
                <div class="social-grid" role="group" aria-label={x("Social media shortcuts")}>
                  {SOCIALS.map(sc => (
                    <button type="button" class="social-btn" data-social={sc.id} data-prefix={sc.prefix} data-ph={sc.ph} aria-pressed="false">
                      {ICONS[sc.id]
                        ? <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor"><path d={ICONS[sc.id]} /></svg>
                        : <span class="social-fallback" aria-hidden="true">in</span>}
                      <span>{sc.label}</span>
                    </button>
                  ))}
                </div>
                <span class="hint">{x("Pick a platform, then replace the highlighted part with your own username.")}</span>
              </div>
            )}
            {t.id === 'wifi' && (
              <label class="switch-row" style="flex:1 1 100%"><span><b>{x("Hidden network")}</b></span><input type="checkbox" class="switch" role="switch" data-field-bool="wifiHidden" /></label>
            )}
          </div>
        ))}
      </div>
    </section>
    {TYPES.map(ty => <HelpBox id={ty.id} helpFor={ty.id} initialHidden={ty.id !== initialType} title={c.help.title_type.replace('{t}', I.t('p_' + ty.id))} items={c.help[ty.id]} />)}
    </div>

    <div class="panel panel-stack" role="tabpanel" id="panel-design" aria-labelledby="tab-design" data-panel="design" hidden>
    <section class="card">
      <div class="card-bar"><span>{x("Settings")}</span><button type="button" class="collapse-btn" data-action="togglePanel" aria-expanded="true" aria-label={x("Collapse settings")}>−</button></div>
      <div class="card-body">
        <div class="group">
          <div class="group-head"><span class="label">{x("Presets")}</span><button type="button" class="link-btn" data-action="resetDesign">{x("Reset design")}</button></div>
          <div class="pills" role="group" aria-label="What a preset changes">
            <button type="button" class="pill" data-opt="presetMode" data-value="all" aria-pressed="true">{x("Shapes + colors")}</button>
            <button type="button" class="pill" data-opt="presetMode" data-value="shape" aria-pressed="false">{x("Shapes only")}</button>
            <button type="button" class="pill shuffle" data-action="shufflePreset" title="Pick a random preset">{x("⤮ Shuffle")}</button>
          </div>
          <div class="presets">
            {PRESETS.map((p, i) => <button type="button" class="preset" data-preset={i}><span class="preset-thumb" set:html={presetSvgs[i]}></span>{N(p.name)}</button>)}
          </div>
          <button type="button" class="link-btn" data-action="togglePresets" aria-expanded="false">{I.t('d_all', { n: PRESETS.length })}</button>
        </div>
        <div class="group"><span class="label">{x("Body shape")}</span>
          <div class="tiles">{BODY.map(([id, l]) => <button type="button" class="tile" data-opt="body" data-value={id} title={N(l)} aria-label={N(l)} aria-pressed={id === 'square' ? 'true' : 'false'} set:html={bodyThumb(id)} />)}</div>
        </div>
        <div class="group"><span class="label">{x("Eye frame")}</span>
          <div class="tiles">{FRAME.map(([id, l]) => <button type="button" class="tile" style="padding:14px" data-opt="frame" data-value={id} title={N(l)} aria-label={N(l)} aria-pressed={id === 'square' ? 'true' : 'false'} set:html={frameThumb(id)} />)}</div>
        </div>
        <div class="group"><span class="label">{x("Eye ball")}</span>
          <div class="tiles">{BALL.map(([id, l]) => <button type="button" class="tile" style="padding:14px" data-opt="ball" data-value={id} title={N(l)} aria-label={N(l)} aria-pressed={id === 'square' ? 'true' : 'false'} set:html={ballThumb(id)} />)}</div>
        </div>
        <div class="group"><span class="label">{x("QR frame")}</span>
          <div class="tiles qf-tiles">{QFRAMES.map(([id, l]) => <button type="button" class="tile" data-opt="qf" data-value={id} title={N(l)} aria-label={N(l)} aria-pressed={id === 'none' ? 'true' : 'false'} set:html={qrFrameThumb(id, N(l))} />)}</div>
          <label class="field qf-text" data-show="qfOn" hidden><span class="label">{x("Frame text")}</span><input class="input" type="text" data-str="qfText" maxlength="28" value={I.t('qf_text')} /></label>
        </div>
      </div>
    </section>
    <HelpBox id="design" title={c.help.design.title} items={c.help.design.items} />
    </div>

    <div class="panel panel-stack" role="tabpanel" id="panel-logo" aria-labelledby="tab-logo" data-panel="logo" hidden>
    <section class="card">
      <div class="card-bar"><span>{x("Settings")}</span><button type="button" class="collapse-btn" data-action="togglePanel" aria-expanded="true" aria-label={x("Collapse settings")}>−</button></div>
      <div class="card-body">
        <div class="logo-row">
          <div class="logo-list" data-logo-list></div>
          <label class="upload" data-dropzone><span class="upload-main">{x("Upload images")}</span><small class="upload-hint">{x("or drag and drop")}</small><input type="file" accept="image/*" multiple data-logo-file hidden /></label>
          <button type="button" class="sample-logo sample-none" data-action="noLogo" title={I.t('logo_none')} aria-label={I.t('logo_none')} aria-pressed="true"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="8.5"/><path d="M6 6l12 12"/></svg></button>
          <button type="button" class="link-btn" data-action="removeLogo" data-show="logo" hidden>{x("Remove all logos")}</button>
        </div>
        <div class="sample-logos">
          <span class="label">{I.t('logo_try')}</span>
          <div class="pills" role="group" aria-label={I.t('logo_shape')}>{LOGO_SHAPES.map(st => <button type="button" class="pill" data-opt="iconStyle" data-value={st} aria-pressed={st === 'plain' ? 'true' : 'false'}>{I.t('logo_st_' + (st === 'round' ? 'rounded' : st))}</button>)}</div>
          <label class="range" data-show="iconRound" hidden><span>{I.t('logo_round')}</span><input type="range" min="0" max="100" step="1" data-num="logoRound" value="48" /><output data-out="logoRound" data-suffix="%">48%</output></label>
          <label class="switch-row"><span><b>{I.t('logo_icustom')}</b></span><input type="checkbox" class="switch" role="switch" data-bool="iconCustom" /></label>
          <div class="icon-color" data-show="iconCustom" hidden>
            <div class="colors"><label class="color"><span class="label">{x("Icon color")}</span><span class="color-box"><input type="color" data-color="iconColor" value="#0B0D0C" aria-label={x("Icon color")} /><input type="text" data-hex="iconColor" maxlength="7" value="#0B0D0C" /></span></label></div>
          </div>
          <label class="switch-row"><span><b>{I.t('logo_gcustom')}</b></span><input type="checkbox" class="switch" role="switch" data-bool="iconFgCustom" /></label>
          <div class="icon-color" data-show="iconFgCustom" hidden>
            <div class="colors"><label class="color"><span class="label">{x("Glyph color")}</span><span class="color-box"><input type="color" data-color="iconFg" value="#FFFFFF" aria-label={x("Glyph color")} /><input type="text" data-hex="iconFg" maxlength="7" value="#FFFFFF" /></span></label></div>
          </div>
          <div data-show="iconAny" hidden><ColorPresets scope="icon" targets={[['iconColor', 'Icon color', 'iconCustom'], ['iconFg', 'Glyph color', 'iconFgCustom']]} /></div>
          <div class="sample-row">{SAMPLE_LOGOS.map(l => <button type="button" class="sample-logo" data-sample-logo={l.url} data-ihex={l.hex} data-ipath={l.path} title={l.title} aria-label={l.title} aria-pressed="false"><img src={l.url} alt="" width="28" height="28" /></button>)}</div>
          <div class="kbd-wrap">
            <input class="input" type="search" data-icon-search data-kbd placeholder={I.t('logo_search_ph')} aria-label={I.t('logo_search_ph')} aria-keyshortcuts="/ Control+K Meta+K" autocomplete="off" spellcheck="false" />
            <span class="kbd-hint" aria-hidden="true"><kbd data-kbd-mod>Ctrl K</kbd><span>{I.t('kbd_or')}</span><kbd>/</kbd></span>
          </div>
          <div class="sample-row" data-icon-results hidden></div>
          <p class="hint" data-icon-status hidden></p>
          {/* <p class="hint">{I.t('logo_icons_note')}</p> */}
        </div>
        {/* <p class="hint" data-show="logoMany" hidden>{x("Tap a logo to preview it on the code. Tap − to remove one.")}</p> */}
        <div class="group" data-show="logo" hidden>
          <label class="range"><span>{x("Size")}</span><input type="range" min="10" max="35" step="1" data-num="logoPct" value="22" /><output data-out="logoPct" data-suffix="%">22%</output></label>
          <label class="switch-row"><span><b>{x("Clear modules behind logo")}</b><small>{x("Removes dots under the image for a clean edge")}</small></span><input type="checkbox" class="switch" role="switch" data-bool="clearLogo" checked /></label>
          <label class="switch-row"><span><b>{x("Logo background")}</b><small>{x("Place the logo on a colored rounded square")}</small></span><input type="checkbox" class="switch" role="switch" data-bool="logoBg" /></label>
          <div class="colors" data-show="logoBg" hidden><label class="color"><span class="label">{x("Background color")}</span><span class="color-box"><input type="color" data-color="logoBgColor" value="#FFFFFF" aria-label={x("Background color")} /><input type="text" data-hex="logoBgColor" maxlength="7" value="#FFFFFF" /></span></label></div>
          <label class="switch-row"><span><b>{x("Logo stroke")}</b><small>{x("Add an outline around the logo")}</small></span><input type="checkbox" class="switch" role="switch" data-bool="logoStroke" /></label>
          <div class="logo-row" data-show="logoStroke" hidden>
            <div class="colors" style="flex:1 1 190px"><label class="color"><span class="label">{x("Stroke color")}</span><span class="color-box"><input type="color" data-color="logoStrokeColor" value="#FFFFFF" aria-label={x("Stroke color")} /><input type="text" data-hex="logoStrokeColor" maxlength="7" value="#FFFFFF" /></span></label></div>
            <label class="range" style="flex:1 1 200px"><span>{x("Width")}</span><input type="range" min="1" max="10" step="1" data-num="logoStrokeW" value="3" /><output data-out="logoStrokeW">3</output></label>
          </div>
          <div data-show="logoStyle" hidden>
            <ColorPresets scope="logo" targets={[['logoBgColor', 'Logo background', 'logoBg'], ['logoStrokeColor', 'Logo stroke', 'logoStroke']]} />
          </div>
        </div>
      </div>
    </section>
    <HelpBox id="logo" title={c.help.logo.title} items={c.help.logo.items} />
    </div>

    <div class="panel panel-stack" role="tabpanel" id="panel-colors" aria-labelledby="tab-colors" data-panel="colors" hidden>
    <section class="card">
      <div class="card-bar"><span>{x("Settings")}</span><button type="button" class="collapse-btn" data-action="togglePanel" aria-expanded="true" aria-label={x("Collapse settings")}>−</button></div>
      <div class="card-body">
        <div class="group">
          <label class="switch-row"><span><b>{x("Gradient")}</b><small>{x("Blend two colors across the code")}</small></span><input type="checkbox" class="switch" role="switch" data-bool="gradient" /></label>
          <label class="switch-row"><span><b>{x("Transparent background")}</b><small>{x("PNG, SVG and WebP keep transparency")}</small></span><input type="checkbox" class="switch" role="switch" data-bool="transparent" /></label>
          <label class="switch-row"><span><b>{x("Custom eye colors")}</b><small>{x("Color the three corner markers separately")}</small></span><input type="checkbox" class="switch" role="switch" data-bool="customEyes" /></label>
          <label class="switch-row" data-show="qfOn" hidden><span><b>{I.t('qf_ctext')}</b><small>{I.t('qf_ctext_s')}</small></span><input type="checkbox" class="switch" role="switch" data-bool="qfCustomText" /></label>
        </div>
        <div class="logo-row" data-show="gradient" hidden>
          <div class="pills" role="group" aria-label="Gradient type">
            <button type="button" class="pill" data-opt="gradType" data-value="linear" aria-pressed="true">{x("Linear")}</button>
            <button type="button" class="pill" data-opt="gradType" data-value="radial" aria-pressed="false">{x("Radial")}</button>
          </div>
          <label class="range" data-show="linear" style="flex:1 1 200px"><span>{x("Angle")}</span><input type="range" min="0" max="360" step="5" data-num="gradAngle" value="45" /><output data-out="gradAngle" data-suffix="°">45°</output></label>
        </div>
        <div class="colors">
          <label class="color"><span class="label" data-fg-label>{x("Code color")}</span><span class="color-box"><input type="color" data-color="fg" value={DESIGN_DEFAULTS.fg} aria-label={x("Code color")} /><input type="text" data-hex="fg" maxlength="7" value={DESIGN_DEFAULTS.fg} /></span></label>
          <label class="color" data-show="gradient" hidden><span class="label">{x("Gradient end")}</span><span class="color-box"><input type="color" data-color="grad2" value={DESIGN_DEFAULTS.grad2} aria-label={x("Gradient end")} /><input type="text" data-hex="grad2" maxlength="7" value={DESIGN_DEFAULTS.grad2} /></span></label>
          <label class="color" data-show="bg"><span class="label">{x("Background")}</span><span class="color-box"><input type="color" data-color="bg" value={DESIGN_DEFAULTS.bg} aria-label={x("Background color")} /><input type="text" data-hex="bg" maxlength="7" value={DESIGN_DEFAULTS.bg} /></span></label>
          <label class="color" data-show="eyes" hidden><span class="label">{x("Eye frame")}</span><span class="color-box"><input type="color" data-color="frameColor" value={DESIGN_DEFAULTS.frameColor} aria-label="Eye frame color" /><input type="text" data-hex="frameColor" maxlength="7" value={DESIGN_DEFAULTS.frameColor} /></span></label>
          <label class="color" data-show="eyes" hidden><span class="label">{x("Eye ball")}</span><span class="color-box"><input type="color" data-color="ballColor" value={DESIGN_DEFAULTS.ballColor} aria-label="Eye ball color" /><input type="text" data-hex="ballColor" maxlength="7" value={DESIGN_DEFAULTS.ballColor} /></span></label>
          <label class="color" data-show="qfOn" hidden><span class="label">{x("Frame color")}</span><span class="color-box"><input type="color" data-color="qfColor" value={DESIGN_DEFAULTS.qfColor} aria-label={x("Frame color")} /><input type="text" data-hex="qfColor" maxlength="7" value={DESIGN_DEFAULTS.qfColor} /></span></label>
          <label class="color" data-show="qfOn" hidden><span class="label">{x("Frame inside")}</span><span class="color-box"><input type="color" data-color="qfBg" value={DESIGN_DEFAULTS.qfBg} aria-label={x("Frame inside")} /><input type="text" data-hex="qfBg" maxlength="7" value={DESIGN_DEFAULTS.qfBg} /></span></label>
          <label class="color" data-show="qfTextColor" hidden><span class="label">{I.t('qf_textcolor_l')}</span><span class="color-box"><input type="color" data-color="qfTextColor" value={DESIGN_DEFAULTS.qfTextColor} aria-label={I.t('qf_textcolor_l')} /><input type="text" data-hex="qfTextColor" maxlength="7" value={DESIGN_DEFAULTS.qfTextColor} /></span></label>
        </div>
        <ColorPresets scope="colors" targets={[['fg', 'Code'], ['grad2', 'Gradient end', 'gradient'], ['bg', 'Background', 'bg'], ['frameColor', 'Eye frame', 'eyes'], ['ballColor', 'Eye ball', 'eyes'], ['qfColor', 'QR frame', 'qfOn'], ['qfBg', 'Frame inside', 'qfOn'], ['qfTextColor', 'Text color', 'qfTextColor']]} />
      </div>
    </section>
    <HelpBox id="colors" title={c.help.colors.title} items={c.help.colors.items} />
    </div>

    <div class="panel panel-stack" role="tabpanel" id="panel-encoding" aria-labelledby="tab-encoding" data-panel="encoding" hidden>
    <section class="card">
      <div class="card-bar"><span>{x("Settings")}</span><button type="button" class="collapse-btn" data-action="togglePanel" aria-expanded="true" aria-label={x("Collapse settings")}>−</button></div>
      <div class="card-body">
        <div class="group"><span class="label">{x("Error correction")}</span>
          <div class="ecc-grid">{ECC.map(([v, l, d]) => <button type="button" class="ecc" data-opt="ecc" data-value={v} aria-pressed={v === 'M' ? 'true' : 'false'}><b>{x(l)} ({v})</b><small>{d.replace('recovery', x('recovery'))}</small></button>)}</div>
        </div>
        <label class="switch-row"><span><b>{x("Boost error correction")}</b><small>{x("Raise ECC when it fits without growing the version")}</small></span><input type="checkbox" class="switch" role="switch" data-bool="boost" checked /></label>
        <div class="group"><span class="label">{x("Mask pattern")}</span>
          <div class="pills">{[-1, 0, 1, 2, 3, 4, 5, 6, 7].map(m => <button type="button" class="pill mono" data-opt="mask" data-numeric data-value={m} aria-pressed={m === -1 ? 'true' : 'false'}>{m === -1 ? x('Auto') : m}</button>)}</div>
        </div>
        <div class="group">
          <label class="range"><span>{x("Min version")}</span><input type="range" min="1" max="40" data-num="minVer" value="1" /><output data-out="minVer">1</output></label>
          <label class="range"><span>{x("Max version")}</span><input type="range" min="1" max="40" data-num="maxVer" value="40" /><output data-out="maxVer">40</output></label>
        </div>
      </div>
    </section>
    <HelpBox id="encoding" title={c.help.encoding.title} items={c.help.encoding.items} />
    </div>
  </div>

  <aside class="gen-side" aria-label="Preview and download">
    <div class="preview-card">
      <div class="well">
        <div class="qr-box" data-qr-box>
          <div data-qr role="img" aria-label="QR code preview" set:html={initialSvg} style="width:100%;height:100%"></div>
          <p class="qr-msg" data-qr-msg hidden={isUrl}>{x("Fill in the content fields to generate your QR code.")}</p>
        </div>
      </div>
      <div class="qr-actions">
        <button type="button" class="btn ghost fav-btn" data-action="fav" aria-pressed="false"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 20.5s-7.5-4.6-9.2-9.4C1.7 7.900 3.900 5 6.900 5c2 0 3.800 1.100 5.100 3 1.300-1.900 3.100-3 5.100-3 3 0 5.200 2.900 4.100 6.100-1.700 4.800-9.200 9.400-9.200 9.400z"/></svg><span data-fav-label>{I.t('fav_add')}</span></button>
        <button type="button" class="btn ghost" data-action="resetAll"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.700"/><path d="M3 4v5h5"/></svg>{I.t('reset_all')}</button>
        <div class="warn-wrap" data-show="anyWarn" hidden>
          <button type="button" class="btn ghost warn-btn" data-action="toggleWarn" aria-expanded="false" aria-label={I.t('warn_l')} title={I.t('warn_l')}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5 2.5 20h19z"/><path d="M12 10v4.500M12 17.200v.1"/></svg></button>
          <div class="warn-pop" role="status">
            <p class="warn" data-show="lowContrast" hidden>{x("Low contrast between code and background. Some scanners may fail — keep the code darker than the background.")}</p>
            <p class="warn" data-show="logoWarn" hidden>{x("A logo hides part of the code. Use error correction Q or H so it still scans.")} <button type="button" data-action="eccHigh">{x("Switch to High")}</button></p>
          </div>
        </div>
      </div>
      <div class="group tweak">
        <label class="range"><span>{x("Margin")}</span><input type="range" min="0" max="10" data-num="border" value="4" /><output data-out="border">4</output></label>
        <label class="range"><span>{x("Rounded corners")}</span><input type="range" min="0" max="35" step="1" data-num="radius" value="0" /><output data-out="radius" data-suffix="%">0%</output></label>
      </div>
      <div class="group" style="gap:8px">
        <label class="range"><span>{x("Quality")}</span><input type="range" min="4" max="12" step="1" data-pow="exportSize" value="10" /><output data-out="exportSize">1024 × 1024</output></label>
        <span class="hint" data-scale-hint>{x("SVG scales to any size")}</span>
      </div>
      <div class="btns">
        <button type="button" class="btn primary" data-dl="png">{x("Download PNG")}</button>
        <div class="btn-row">
          <button type="button" class="btn" data-dl="svg">SVG</button>
          <button type="button" class="btn" data-dl="jpeg">JPG</button>
          <button type="button" class="btn" data-dl="webp">WebP</button>
        </div>
        <div class="btn-row copy-row">
          <button type="button" class="btn ghost" data-action="copySvg" aria-live="polite">{x("Copy SVG")}</button>
          <button type="button" class="btn ghost" data-action="copyImg" aria-live="polite">{x("Copy image")}</button>
          <button type="button" class="btn ghost" data-action="printPdf" title="Opens a print-ready page. Choose “Save as PDF” in the print dialog.">{x("Print / PDF")}</button>
        </div>
      </div>
      <details class="qr-details" data-details>
        <summary>{x("QR details & code")}</summary>
        <dl class="stats">
          <div><dt>{x("Version")}</dt><dd data-stat="version">{initialQr.version}</dd></div>
          <div><dt>{x("Modules")}</dt><dd data-stat="modules">{initialQr.size} × {initialQr.size}</dd></div>
          <div><dt>{x("Error correction")}</dt><dd data-stat="ecc">—</dd></div>
          <div><dt>{x("Mask pattern")}</dt><dd data-stat="mask">—</dd></div>
          <div><dt>{x("Encoding mode")}</dt><dd data-stat="mode">—</dd></div>
          <div><dt>{x("Characters")}</dt><dd data-stat="chars">—</dd></div>
          <div><dt>{x("Data bits")}</dt><dd data-stat="bits">—</dd></div>
          <div><dt>{x("Capacity used")}</dt><dd data-stat="used">—</dd></div>
        </dl>

        <div class="code-out" data-code>
          <label class="field"><span class="label">{x("Encoded text")}</span><textarea class="input" rows="3" readonly data-payload></textarea></label>
          <label class="field"><span class="label">{x("SVG XML code")}</span><textarea class="input" rows="6" readonly data-svg-code></textarea></label>
        </div>
      </details>
    </div>
  </aside>
  </div>
</div>

<dialog class="crop-dlg" data-crop aria-labelledby="crop-title">
  <h3 id="crop-title">{I.t('crop_title')}</h3>
