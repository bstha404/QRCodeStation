---
import '../styles/global.css';
import { getLocale, localeInfo, alternatesFor, stripLocale, isTranslatable } from '../i18n/index.js';
interface Props { title: string; description: string; jsonLd?: object[]; noindex?: boolean; }
const { title, description, jsonLd = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const locale = getLocale(Astro.url.pathname);
const info = localeInfo(locale);
const basePath = stripLocale(Astro.url.pathname);
const alternates = isTranslatable(basePath) && !noindex ? alternatesFor(basePath, Astro.site) : [];
const ogImage = new URL('/og-image.png', Astro.site);
---
<!doctype html>
<html lang={locale} dir={info.dir} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {alternates.map(a => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="author" href="/humans.txt" />
    <meta name="theme-color" content="#F2F5F2" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="QR Code Station" />
    <meta property="og:locale" content={info.og} />
    {alternates.filter(a => a.locale !== locale && a.hreflang !== 'x-default').map(a => <meta property="og:locale:alternate" content={localeInfo(a.locale).og} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
    {jsonLd.map(d => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <slot />
  </body>
</html>
